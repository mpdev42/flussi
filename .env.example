# Référence des variables — ne jamais renseigner de valeur réelle ici.
# En dev : copier en .env (ignoré par git).
# Application installée : %ProgramData%\Flussi\config.json (non secrets) ; secrets saisis une fois par l'administrateur, stockés chiffrés.
#
# Règles de lecture en dev :
# - Seul ce fichier .env est lu pour la configuration : les variables d'environnement du terminal sont ignorées.
# - Une valeur vide (CLE=) vaut absence de valeur.
# - Une clé inconnue (faute de frappe) fait refuser le démarrage.
# - %ProgramData%\Flussi\config.json n'est jamais lu en dev.

# Environnement
# En dev, seule la valeur « recette » est acceptée : « prod » est refusé (le travail en production se fait avec Flussi installé).
FLUSSI_ENV=recette

# Stockage (dossiers de travail — P: en v1.0)
# Chemins absolus : lecteur (X:\...) ou réseau (\\serveur\partage\...). Aucun dossier par défaut en recette.
# STOCKAGE_DOSSIER_TRAVAIL suffit : IN, OUT et Journal en sont dérivés ({TRAVAIL}\IN, {TRAVAIL}\OUT, {TRAVAIL}\Journal).
# Sinon, renseigner les trois dossiers ci-dessous. Chacun peut aussi surcharger le dossier dérivé.
STOCKAGE_DOSSIER_TRAVAIL=
STOCKAGE_DOSSIER_IN=
STOCKAGE_DOSSIER_OUT=
STOCKAGE_DOSSIER_JOURNAL=

# VEOS (IGA)
VEOS_URL=
VEOS_WORKFLOW_EXPORT_ID=

# IGA — FTP
IGA_FTP_HOST=
IGA_FTP_USER=
# Dev uniquement : l'application installée utilise le secret saisi par l'administrateur.
IGA_FTP_PASSWORD=
IGA_FTP_DOSSIER=

# MSP — SFTP
MSP_SFTP_HOST=
MSP_SFTP_PORT=
MSP_SFTP_USER=
# Dev uniquement : l'application installée utilise le secret saisi par l'administrateur.
MSP_SFTP_PASSWORD=
# Dev uniquement : l'application installée importe le contenu de la clé.
MSP_SFTP_CLE_PRIVEE_CHEMIN=
MSP_SFTP_DOSSIER_DEPOT=
MSP_SFTP_DOSSIER_RETRAIT=

# Tests — corpus AC056 de référence sur P: (données réelles, jamais copiées dans le dépôt)
# Dossier contenant IN\, OUT\, PIEGES\ et MODIFIES\. Absent : les tests corpus sont ignorés par npm test.
# Accepté seulement dans le .env.
AC056_CORPUS_DIR=
