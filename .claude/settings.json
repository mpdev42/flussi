      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c *)",
      "Bash(git switch main)",
      "Bash(git checkout -b *)",
      "Bash(git stash list *)",
