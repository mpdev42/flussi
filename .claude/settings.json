      "PowerShell(gh run view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Location)",
      "PowerShell(Get-Command *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Group-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(Format-List *)",
      "PowerShell(Out-String *)",
      "PowerShell(ConvertFrom-Json *)",
      "PowerShell(ConvertTo-Json *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(*.ssh*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rmdir *)",
      "PowerShell(*.ssh*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(*.env*)",
      "PowerShell(*.env*)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)",
      "Bash(npx playwright test *)",
      "PowerShell(npx playwright test *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
